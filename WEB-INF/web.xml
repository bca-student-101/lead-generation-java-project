<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.admin.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/AdminLoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LeadSubmissionServlet</servlet-name>
        <servlet-class>com.admin.LeadSubmissionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeadSubmissionServlet</servlet-name>
        <url-pattern>/LeadSubmissionServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateContentServlet</servlet-name>
        <servlet-class>UpdateContentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateContentServlet</servlet-name>
        <url-pattern>/UpdateContentServlet</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
